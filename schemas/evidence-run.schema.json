{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "producer",
    "inputHash",
    "status",
    "proof",
    "outputs"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "partial",
        "unavailable"
      ]
    },
    "proof": {
      "type": "string",
      "minLength": 1
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "type": "object"
    }
  },
  "title": "evidence-run"
}
