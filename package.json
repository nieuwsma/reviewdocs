{
  "name": "reviewdocs",
  "version": "0.5.0",
  "description": "Configuration-driven documentation, architecture reference, and engineering review evidence generator",
  "type": "module",
  "bin": {
    "reviewdocs": "./bin/reviewdocs.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./provenance": "./src/provenance.mjs",
    "./schemas/*": "./schemas/*",
    "./foundation": "./src/foundation.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "schemas",
    "docs/usage.md",
    "docs/tool-comparison.md"
  ],
  "scripts": {
    "build:example": "node ./bin/reviewdocs.mjs build --config example/reviewdocs.config.mjs",
    "check:example": "node ./bin/reviewdocs.mjs check --config example/reviewdocs.config.mjs",
    "test": "node --test",
    "check": "npm test && npm run build:example && npm run check:example",
    "prepack": "npm run check",
    "check:browser": "node scripts/check-browser.mjs",
    "capture:example": "node scripts/check-browser.mjs --capture"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "documentation",
    "engineering-review",
    "evidence",
    "openapi",
    "mermaid",
    "schemaspy"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "marked": "17.0.5",
    "marked-gfm-heading-id": "4.1.3",
    "swagger-ui-dist": "5.32.15",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
